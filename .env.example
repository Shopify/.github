# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Google Service Account credentials
# Provide one of these:
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=

# The user to impersonate for domain-wide delegation
GOOGLE_IMPERSONATED_USER=

# Optional: upload small files to Slack automatically (< ~0.8 MB)
ENABLE_SMALL_FILE_UPLOAD=false
MAX_UPLOAD_BYTES=800000

# Server
PORT=3000
